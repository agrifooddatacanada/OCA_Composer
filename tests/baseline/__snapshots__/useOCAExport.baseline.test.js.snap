exports[`useOCAExport manual export baseline richBilingual: DSL and exported package: dsl 1`] = `
"# add attributes (capture base)
ADD ATTRIBUTE bird_id=Text live_weight=Numeric hatch_date=DateTime treatment=Text visits=Array[Text]
# Add classification
ADD classification Biological sciences
# Add meta overlay
ADD Meta en PROPS name=\\"Poultry trial\\" description=\\"Broiler feeding trial\\"
ADD Meta fr PROPS name=\\"Poultry trial\\" description=\\"Broiler feeding trial\\"
# Add Format Overlay
ADD Format ATTRS bird_id=\\"^[A-Z]{2}[0-9]{3}$\\" live_weight=\\"^-?[0-9]+(\\\\.[0-9]+)?$\\" hatch_date=\\"YYYY-MM-DD\\"
# Add Conformance Overlay
ADD CONFORMANCE ATTRS bird_id=M live_weight=O hatch_date=O treatment=M visits=O
# Add Cardinality Overlay
ADD CARDINALITY ATTRS visits=\\"1-3\\"
# Add label overlay
ADD Label en ATTRS bird_id=\\"Bird\\" live_weight=\\"Live weight\\" hatch_date=\\"Hatch date\\" treatment=\\"Treatment\\" visits=\\"Visits\\"
ADD Label fr ATTRS bird_id=\\"Oiseau\\" live_weight=\\"Poids vif\\" hatch_date=\\"Date d'éclosion\\" treatment=\\"Traitement\\" visits=\\"Visites\\"
# Add information overlay
ADD Information en ATTRS bird_id=\\"Bird identifier\\" live_weight=\\"Weight at day 42\\" treatment=\\"Diet group\\" visits=\\"Vet visits\\"
ADD Information fr ATTRS bird_id=\\"Identifiant de l'oiseau\\" live_weight=\\"Poids au jour 42\\" treatment=\\"Groupe alimentaire\\" visits=\\"Visites vétérinaires\\"
# Add entry code overlay
ADD ENTRY_CODE ATTRS treatment=[\\"CTRL\\", \\"HIGH\\"]
ADD ENTRY en ATTRS treatment={\\"CTRL\\": \\"Control diet\\", \\"HIGH\\": \\"High-protein diet\\"}
ADD ENTRY fr ATTRS treatment={\\"CTRL\\": \\"Régime témoin\\", \\"HIGH\\": \\"Régime riche en protéines\\"}

# Add units overlay
ADD Unit ATTRS live_weight=\\"g\\"
# Add character encoding overlay
ADD CHARACTER_ENCODING ATTRS bird_id=\\"utf-8\\"
"
`;

