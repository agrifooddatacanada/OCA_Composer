exports[`useOCAExport manual export baseline adversarialEscaping: DSL and exported package: dsl 1`] = `
"# add attributes (capture base)
ADD ATTRIBUTE q1=Text q2=Text
# Add classification
# Add meta overlay
ADD Meta en PROPS name=\\"He said \\\\\\"hello\\\\\\"\\" description=\\"Backslash \\\\\\\\ and \\\\\\"quotes\\\\\\" and, commas\\"
# Add Format Overlay
ADD Format ATTRS q2=\\"^\\\\\\"quoted\\\\\\"\\\\d+$\\"
# Add Conformance Overlay
# Add Cardinality Overlay
# Add label overlay
ADD Label en ATTRS q1=\\"Label with \\\\\\"quotes\\\\\\"\\" q2=\\"Back\\\\\\\\slash\\"
# Add information overlay
ADD Information en ATTRS q1=\\"Line one
Line two\\" q2=\\"Tab	separated, and = signs\\"
# Add entry code overlay
ADD ENTRY_CODE ATTRS q1=[\\"a\\\\\\"b\\", \\"c,d\\"]
ADD ENTRY en ATTRS q1={\\"a\\\\\\"b\\": \\"Label \\\\\\"A\\\\\\"\\", \\"c,d\\": \\"Comma, label\\"}

# Add units overlay
# Add character encoding overlay
"
`;

